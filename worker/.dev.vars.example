# Copy this file to worker/.dev.vars (gitignored) for local `wrangler dev` runs.
#
# Only needed for the /api/hypixel/import route (see handleHypixelImport in src/index.js) —
# /api/items and /api/refresh don't touch the Hypixel API and work without this. Get a key at
# https://developer.hypixel.net/.
HYPIXEL_API_KEY=your-hypixel-api-key-here
