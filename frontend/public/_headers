# Report-Only for now: violations show in the browser console without blocking anything. Once a
# deploy runs clean, rename the header to Content-Security-Policy to enforce it.
/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://mc-heads.net; connect-src 'self' https://dmg-calc-cache.mich536ael.workers.dev https://raw.githubusercontent.com https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Frame-Options: DENY

/images/*
  Cache-Control: public, max-age=86400

# Same treatment as /images/* - the Tutorial and Examples screenshots are equally static, but they
# live outside /images/ and so were falling through to Pages' default (max-age=0, must-revalidate),
# costing a revalidation round-trip per screenshot per visit.
/tutorial/*
  Cache-Control: public, max-age=86400

/examples/*
  Cache-Control: public, max-age=86400
